{%- comment -%}
  ACCOUNT — SET A NEW PASSWORD

  Reached from the link in the recovery email. Two fields, nothing else.
{%- endcomment -%}

{% render 'account-styles' %}

<div class="ps-account">
  <div class="ps-shell ps-shell--narrow">

    <header class="ps-account__head">
      <p class="ps-eyebrow" data-ps-reveal="fade">{{ 'customer.account.title' | t | default: 'Account' }}</p>
      <h1 class="ps-account__title" data-ps-split="lines">
        {{- 'customer.reset_password.title' | t | default: 'Set a new password' -}}
      </h1>
      <p class="ps-lede ps-account__lede" data-ps-reveal="up">
        {{ 'customer.reset_password.subtext' | t: email: email | default: 'Choose something you will remember.' }}
      </p>
      <div class="ps-account__thread" aria-hidden="true">
        {% render 'icon', name: 'thread', draw: true %}
      </div>
    </header>

    <div class="ps-auth">
      <section class="ps-account__panel">
        {% form 'reset_customer_password' %}
          {%- if form.errors -%}
            <div class="ps-note ps-note--bad" role="alert">
              <p class="ps-note__title">{{ 'customer.reset_password.error' | t | default: 'That did not go through.' }}</p>
              <ul class="ps-note__list">
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="ps-account__fields">
            <p class="ps-field ps-field--wide">
              <input
                class="ps-input"
                type="password"
                id="ps-reset-password"
                name="customer[password]"
                autocomplete="new-password"
                placeholder=" "
                required>
              <label class="ps-label" for="ps-reset-password">
                {{ 'customer.reset_password.password' | t | default: 'New password' }}
              </label>
            </p>

            <p class="ps-field ps-field--wide">
              <input
                class="ps-input"
                type="password"
                id="ps-reset-confirm"
                name="customer[password_confirmation]"
                autocomplete="new-password"
                placeholder=" "
                required>
              <label class="ps-label" for="ps-reset-confirm">
                {{ 'customer.reset_password.password_confirm' | t | default: 'Again, to be sure' }}
              </label>
            </p>
          </div>

          <div class="ps-account__actions">
            <button class="ps-btn" type="submit" data-ps-magnetic="0.18">
              {{ 'customer.reset_password.submit' | t | default: 'Save it' }}
            </button>
          </div>
        {% endform %}
      </section>
    </div>

  </div>
</div>
