{%- comment -%}
  ACCOUNT — ADDRESSES

  Saved addresses as cards, each with its edit form folded into a <details> so
  nothing needs JavaScript to open. Deleting posts a real form with the
  _method override rather than relying on a script.
{%- endcomment -%}

{% render 'account-styles' %}

<div class="ps-account">
  <div class="ps-shell">

    <header class="ps-account__head">
      <p class="ps-eyebrow" data-ps-reveal="fade">
        <a href="{{ routes.account_url }}">{{ 'customer.account.title' | t | default: 'Account' }}</a>
      </p>
      <h1 class="ps-account__title" data-ps-split="lines">
        {{- 'customer.addresses.title' | t | default: 'Where we send things' -}}
      </h1>
      <div class="ps-account__thread" aria-hidden="true">
        {% render 'icon', name: 'thread', draw: true %}
      </div>
    </header>

    {%- comment -%} ---- Add a new one ---- {%- endcomment -%}
    <section class="ps-account__panel" data-ps-reveal="up">
      <h2 class="ps-account__panel-head">
        {{ 'customer.addresses.add_new' | t | default: 'Add an address' }}
      </h2>

      {% form 'customer_address', customer.new_address %}
        {%- if form.errors -%}
          <div class="ps-note ps-note--bad" role="alert">
            <p class="ps-note__title">{{ 'customer.addresses.error' | t | default: 'Something in the form needs another look.' }}</p>
            <ul class="ps-note__list">
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="ps-account__fields">
          <p class="ps-field">
            <input class="ps-input" type="text" id="ps-addr-first" name="address[first_name]" autocomplete="given-name" placeholder=" ">
            <label class="ps-label" for="ps-addr-first">{{ 'customer.addresses.first_name' | t | default: 'First name' }}</label>
          </p>
          <p class="ps-field">
            <input class="ps-input" type="text" id="ps-addr-last" name="address[last_name]" autocomplete="family-name" placeholder=" ">
            <label class="ps-label" for="ps-addr-last">{{ 'customer.addresses.last_name' | t | default: 'Last name' }}</label>
          </p>
          <p class="ps-field ps-field--wide">
            <input class="ps-input" type="text" id="ps-addr-company" name="address[company]" autocomplete="organization" placeholder=" ">
            <label class="ps-label" for="ps-addr-company">{{ 'customer.addresses.company' | t | default: 'Company' }}</label>
          </p>
          <p class="ps-field ps-field--wide">
            <input class="ps-input" type="text" id="ps-addr-1" name="address[address1]" autocomplete="address-line1" placeholder=" ">
            <label class="ps-label" for="ps-addr-1">{{ 'customer.addresses.address1' | t | default: 'Address' }}</label>
          </p>
          <p class="ps-field ps-field--wide">
            <input class="ps-input" type="text" id="ps-addr-2" name="address[address2]" autocomplete="address-line2" placeholder=" ">
            <label class="ps-label" for="ps-addr-2">{{ 'customer.addresses.address2' | t | default: 'Apartment, floor, landmark' }}</label>
          </p>
          <p class="ps-field">
            <input class="ps-input" type="text" id="ps-addr-city" name="address[city]" autocomplete="address-level2" placeholder=" ">
            <label class="ps-label" for="ps-addr-city">{{ 'customer.addresses.city' | t | default: 'City' }}</label>
          </p>
          <p class="ps-field">
            <input class="ps-input" type="text" id="ps-addr-province" name="address[province]" autocomplete="address-level1" placeholder=" ">
            <label class="ps-label" for="ps-addr-province">{{ 'customer.addresses.province' | t | default: 'Governorate' }}</label>
          </p>
          <p class="ps-field">
            <input class="ps-input" type="text" id="ps-addr-zip" name="address[zip]" autocomplete="postal-code" placeholder=" ">
            <label class="ps-label" for="ps-addr-zip">{{ 'customer.addresses.zip' | t | default: 'Postal code' }}</label>
          </p>
          <p class="ps-field">
            <input class="ps-input" type="tel" id="ps-addr-phone" name="address[phone]" autocomplete="tel" placeholder=" ">
            <label class="ps-label" for="ps-addr-phone">{{ 'customer.addresses.phone' | t | default: 'Phone' }}</label>
          </p>
          <p class="ps-field ps-field--wide">
            <select class="ps-select" id="ps-addr-country" name="address[country]" autocomplete="country">
              {{ country_option_tags }}
            </select>
            <label class="ps-label" for="ps-addr-country">{{ 'customer.addresses.country' | t | default: 'Country' }}</label>
          </p>
        </div>

        <div class="ps-account__actions">
          <label class="ps-check">
            <input type="checkbox" name="address[default]" value="1">
            {{ 'customer.addresses.set_default' | t | default: 'Make this the default' }}
          </label>
        </div>

        <div class="ps-account__actions">
          <button class="ps-btn" type="submit">
            {{ 'customer.addresses.add' | t | default: 'Save it' }}
          </button>
        </div>
      {% endform %}
    </section>

    {%- comment -%} ---- The saved ones ---- {%- endcomment -%}
    <h2 class="ps-account__panel-head" style="margin-top: var(--ps-s-xl);">
      {{ 'customer.addresses.saved' | t | default: 'Saved addresses' }}
    </h2>

    {%- paginate customer.addresses by 6 -%}
      {%- if customer.addresses.size > 0 -%}
        <div class="ps-addr-grid" data-ps-stagger="80">
          {%- for address in customer.addresses -%}
            <div class="ps-addr" data-ps-reveal="up">
              {%- if address == customer.default_address -%}
                <span class="ps-tag ps-tag--paid" style="align-self: flex-start;">
                  {{ 'customer.addresses.default' | t | default: 'Default' }}
                </span>
              {%- endif -%}

              <div class="ps-addr__body">{{ address | format_address }}</div>

              <div class="ps-addr__row">
                <details class="ps-addr__edit">
                  <summary>{{ 'customer.addresses.edit' | t | default: 'Edit' }}</summary>

                  {% form 'customer_address', address %}
                    <div class="ps-account__fields" style="margin-top: var(--ps-s-s);">
                      <p class="ps-field">
                        <input class="ps-input" type="text" id="ps-edit-first-{{ address.id }}" name="address[first_name]" value="{{ address.first_name | escape }}" autocomplete="given-name" placeholder=" ">
                        <label class="ps-label" for="ps-edit-first-{{ address.id }}">{{ 'customer.addresses.first_name' | t | default: 'First name' }}</label>
                      </p>
                      <p class="ps-field">
                        <input class="ps-input" type="text" id="ps-edit-last-{{ address.id }}" name="address[last_name]" value="{{ address.last_name | escape }}" autocomplete="family-name" placeholder=" ">
                        <label class="ps-label" for="ps-edit-last-{{ address.id }}">{{ 'customer.addresses.last_name' | t | default: 'Last name' }}</label>
                      </p>
                      <p class="ps-field ps-field--wide">
                        <input class="ps-input" type="text" id="ps-edit-1-{{ address.id }}" name="address[address1]" value="{{ address.address1 | escape }}" autocomplete="address-line1" placeholder=" ">
                        <label class="ps-label" for="ps-edit-1-{{ address.id }}">{{ 'customer.addresses.address1' | t | default: 'Address' }}</label>
                      </p>
                      <p class="ps-field ps-field--wide">
                        <input class="ps-input" type="text" id="ps-edit-2-{{ address.id }}" name="address[address2]" value="{{ address.address2 | escape }}" autocomplete="address-line2" placeholder=" ">
                        <label class="ps-label" for="ps-edit-2-{{ address.id }}">{{ 'customer.addresses.address2' | t | default: 'Apartment, floor, landmark' }}</label>
                      </p>
                      <p class="ps-field">
                        <input class="ps-input" type="text" id="ps-edit-city-{{ address.id }}" name="address[city]" value="{{ address.city | escape }}" autocomplete="address-level2" placeholder=" ">
                        <label class="ps-label" for="ps-edit-city-{{ address.id }}">{{ 'customer.addresses.city' | t | default: 'City' }}</label>
                      </p>
                      <p class="ps-field">
                        <input class="ps-input" type="text" id="ps-edit-province-{{ address.id }}" name="address[province]" value="{{ address.province | escape }}" autocomplete="address-level1" placeholder=" ">
                        <label class="ps-label" for="ps-edit-province-{{ address.id }}">{{ 'customer.addresses.province' | t | default: 'Governorate' }}</label>
                      </p>
                      <p class="ps-field">
                        <input class="ps-input" type="text" id="ps-edit-zip-{{ address.id }}" name="address[zip]" value="{{ address.zip | escape }}" autocomplete="postal-code" placeholder=" ">
                        <label class="ps-label" for="ps-edit-zip-{{ address.id }}">{{ 'customer.addresses.zip' | t | default: 'Postal code' }}</label>
                      </p>
                      <p class="ps-field">
                        <input class="ps-input" type="tel" id="ps-edit-phone-{{ address.id }}" name="address[phone]" value="{{ address.phone | escape }}" autocomplete="tel" placeholder=" ">
                        <label class="ps-label" for="ps-edit-phone-{{ address.id }}">{{ 'customer.addresses.phone' | t | default: 'Phone' }}</label>
                      </p>
                      <p class="ps-field ps-field--wide">
                        <select class="ps-select" id="ps-edit-country-{{ address.id }}" name="address[country]" autocomplete="country">
                          {{ address.country | country_option_tags }}
                        </select>
                        <label class="ps-label" for="ps-edit-country-{{ address.id }}">{{ 'customer.addresses.country' | t | default: 'Country' }}</label>
                      </p>
                    </div>

                    <div class="ps-account__actions">
                      <label class="ps-check">
                        <input type="checkbox" name="address[default]" value="1" {% if address == customer.default_address %}checked{% endif %}>
                        {{ 'customer.addresses.set_default' | t | default: 'Make this the default' }}
                      </label>
                    </div>

                    <div class="ps-account__actions">
                      <button class="ps-btn ps-btn--sm" type="submit">
                        {{ 'customer.addresses.update' | t | default: 'Save changes' }}
                      </button>
                    </div>
                  {% endform %}
                </details>

                {%- comment -%} A real form post, so deleting needs no script. {%- endcomment -%}
                <form method="post" action="{{ address.url }}">
                  <input type="hidden" name="_method" value="delete">
                  <button class="ps-addr__del" type="submit">
                    {{ 'customer.addresses.delete' | t | default: 'Delete' }}
                  </button>
                </form>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="ps-pager" aria-label="{{ 'general.pagination.label' | t | default: 'Pagination' }}">
            {%- if paginate.previous -%}
              <a class="ps-pager__link" href="{{ paginate.previous.url }}">
                {% render 'icon', name: 'arrow-left', size: 15 %}
                {{ 'general.pagination.previous' | t | default: 'Newer' }}
              </a>
            {%- endif -%}
            <span class="ps-pager__count ps-num">{{ paginate.current_page }} / {{ paginate.pages }}</span>
            {%- if paginate.next -%}
              <a class="ps-pager__link" href="{{ paginate.next.url }}">
                {{ 'general.pagination.next' | t | default: 'Older' }}
                {% render 'icon', name: 'arrow-right', size: 15 %}
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="ps-account__empty">
          {{ 'customer.addresses.none' | t | default: 'No address saved yet.' }}
        </p>
      {%- endif -%}
    {%- endpaginate -%}

  </div>
</div>
