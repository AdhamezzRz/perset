<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ settings.text_direction | default: 'ltr' }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#F4EEE4">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &middot; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- comment -%}
      Fraunces carries the voice of the brand: a variable serif with SOFT and
      WONK axes that keep the headlines feeling drawn rather than typeset.
      Jost handles everything functional.
    {%- endcomment -%}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,200..700,0..100,0..1;1,9..144,200..700,0..100,0..1&family=Jost:ital,wght@0,300..600;1,300..500&display=swap"
      media="print"
      onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,200..700,0..100,0..1;1,9..144,200..700,0..100,0..1&family=Jost:ital,wght@0,300..600;1,300..500&display=swap">
    </noscript>

    {{ 'perset-core.css' | asset_url | stylesheet_tag }}

    <style>
      {%- if settings.color_accent != blank -%}
        :root { --ps-accent: {{ settings.color_accent }}; }
      {%- endif -%}
      {%- if settings.color_background != blank -%}
        :root { --ps-linen: {{ settings.color_background }}; }
      {%- endif -%}
    </style>

    <script>
      // Set before first paint so the page never flashes an un-themed state.
      document.documentElement.classList.add('ps-js');
    </script>

    {{ content_for_header }}
  </head>

  <body
    class="ps-body template--{{ template.name | handle }}{% if template.suffix %} template-suffix--{{ template.suffix | handle }}{% endif %}"
    data-template="{{ template.name }}">

    <a class="ps-skip" href="#ps-main">{{ 'accessibility.skip_to_text' | t | default: 'Skip to content' }}</a>

    <div class="ps-progress" data-ps-progress aria-hidden="true"></div>

    {% sections 'header-group' %}

    <main id="ps-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script src="{{ 'perset-motion.js' | asset_url }}" defer></script>
    <script src="{{ 'perset-cart.js' | asset_url }}" defer></script>

    <script type="application/json" id="ps-routes">
      {
        "cart_add": {{ routes.cart_add_url | json }},
        "cart_change": {{ routes.cart_change_url | json }},
        "cart_update": {{ routes.cart_update_url | json }},
        "cart": {{ routes.cart_url | json }},
        "predictive_search": {{ routes.predictive_search_url | json }}
      }
    </script>

    <div id="ps-live" class="ps-sr" role="status" aria-live="polite"></div>
  </body>
</html>
