<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{{ settings.text_direction | default: 'ltr' }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#F4EEE4">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>{{ shop.name }}{% if page_title != shop.name %} &middot; {{ page_title }}{% endif %}</title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- comment -%} Same two families as the main layout. The password page is not a different brand. {%- endcomment -%}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,200..700,0..100,0..1;1,9..144,200..700,0..100,0..1&family=Jost:ital,wght@0,300..600;1,300..500&display=swap"
      media="print"
      onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,200..700,0..100,0..1;1,9..144,200..700,0..100,0..1&family=Jost:ital,wght@0,300..600;1,300..500&display=swap">
    </noscript>

    {{ 'perset-core.css' | asset_url | stylesheet_tag }}
    <style>:root { --ps-logo-url: url({{ 'perset-logo-mask.png' | asset_url | json }}); }</style>

    <style>
      {%- if settings.color_accent != blank -%}
        :root { --ps-accent: {{ settings.color_accent }}; }
      {%- endif -%}
      {%- if settings.color_background != blank -%}
        :root { --ps-linen: {{ settings.color_background }}; }
      {%- endif -%}

      /* The password page carries its own small layer of styles — it is the one
         document in the theme that never loads a header or a footer. */
      .ps-pw {
        min-height: 100svh;
        display: grid;
        grid-template-rows: auto 1fr auto;
        position: relative;
        isolation: isolate;
      }
      .ps-pw__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--ps-s-s);
        padding-block: var(--ps-s-m);
      }
      .ps-pw__foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--ps-s-s);
        flex-wrap: wrap;
        padding-block: var(--ps-s-m) var(--ps-s-l);
        font-size: var(--ps-step--2);
        letter-spacing: 0.08em;
        color: var(--ps-ink-faint);
      }

      /* The staff door. Closed by default, opened by the details toggle, so
         nobody has to look at a password field to read the page. */
      .ps-pw__door { position: relative; }
      .ps-pw__door summary {
        list-style: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.55em;
        font-size: var(--ps-step--2);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--ps-ink-faint);
        transition: color var(--ps-t-fast) var(--ps-ease-swap);
      }
      .ps-pw__door summary::-webkit-details-marker { display: none; }
      .ps-pw__door summary:hover { color: var(--ps-ink); }
      .ps-pw__door[open] summary { color: var(--ps-ink); }

      .ps-pw__form {
        display: flex;
        align-items: flex-end;
        gap: var(--ps-s-s);
        width: min(100%, 26rem);
        margin-top: var(--ps-s-s);
        animation: ps-pw-in var(--ps-t-base) var(--ps-ease-set) both;
      }
      @keyframes ps-pw-in {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: none; }
      }
      .ps-pw__form .ps-field { flex: 1; }
      .ps-pw__error {
        margin-top: var(--ps-s-2xs);
        font-size: var(--ps-step--1);
        color: var(--ps-coral-deep);
      }
      @media (max-width: 480px) {
        .ps-pw__form { flex-wrap: wrap; }
        .ps-pw__form .ps-btn { width: 100%; }
      }
    </style>

    {{ content_for_header }}
  </head>

  <body class="ps-body template--password" data-template="password">

    <a class="ps-skip" href="#ps-main">{{ 'accessibility.skip_to_text' | t | default: 'Skip to content' }}</a>

    <div class="ps-pw">

      <header class="ps-shell ps-shell--wide ps-pw__top">
        <span class="ps-logo">{% render 'logo', width: 'clamp(96px, 14vw, 140px)' %}</span>
        <span class="ps-eyebrow ps-eyebrow--bare">
          {{ 'general.password_page.opening_soon' | t | default: 'Opening soon' }}
        </span>
      </header>

      <main id="ps-main" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      <footer class="ps-shell ps-shell--wide ps-pw__foot">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>

        {%- comment -%}
          The storefront password form. Shopify re-renders this page with
          form.errors when the password is wrong, so the door stays open.
        {%- endcomment -%}
        {% form 'storefront_password' %}
          <details class="ps-pw__door"{% if form.errors %} open{% endif %}>
            <summary>
              {{ 'general.password_page.login_form_heading' | t | default: 'Enter with a password' }}
            </summary>

            <div class="ps-pw__form">
              <p class="ps-field">
                <input
                  class="ps-input"
                  type="password"
                  id="ps-password"
                  name="password"
                  autocomplete="current-password"
                  placeholder=" "
                  {% if form.errors %}aria-invalid="true" aria-describedby="ps-password-error"{% endif %}>
                <label class="ps-label" for="ps-password">
                  {{ 'general.password_page.login_form_password_label' | t | default: 'Password' }}
                </label>
              </p>
              <button class="ps-btn ps-btn--sm" type="submit">
                {{ 'general.password_page.login_form_submit' | t | default: 'Enter' }}
              </button>
            </div>

            {%- if form.errors -%}
              <p class="ps-pw__error" id="ps-password-error" role="alert">
                {{ 'general.password_page.login_form_error' | t | default: 'That password is not right.' }}
              </p>
            {%- endif -%}
          </details>
        {% endform %}

        <span>{{ 'general.password_page.powered_by_shopify' | t | default: 'Powered by Shopify' }}</span>
      </footer>
    </div>

    <script src="{{ 'perset-motion.js' | asset_url }}" defer></script>
  </body>
</html>
