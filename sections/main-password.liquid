{%- comment -%}
  PASSWORD — COMING SOON

  The shop before it opens. One plate turning behind the headline, the
  merchant's password message, and a place to leave an email.

  The signup uses Shopify's customer form, which on the password page adds the
  address to the store's list and nothing else.
{%- endcomment -%}

<section
  class="ps-coming"
  {% if section.settings.pigment != 'none' %}data-ps-pigment="{{ section.settings.pigment }}"{% endif %}>

  <span class="ps-coming__wash" aria-hidden="true"></span>

  <div class="ps-shell ps-coming__inner">

    <div class="ps-coming__text">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ps-eyebrow" data-ps-reveal="fade">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="ps-coming__title ps-lines">
        {%- if section.settings.line_1 != blank -%}
          <span class="ps-line-mask"><span class="ps-line-inner" style="--ps-delay:120ms">{{ section.settings.line_1 }}</span></span>
        {%- endif -%}
        {%- if section.settings.line_2 != blank -%}
          <span class="ps-line-mask"><span class="ps-line-inner" style="--ps-delay:240ms">{{ section.settings.line_2 }}</span></span>
        {%- endif -%}
        {%- if section.settings.line_3 != blank -%}
          <span class="ps-line-mask"><span class="ps-line-inner" style="--ps-delay:360ms">{{ section.settings.line_3 }}</span></span>
        {%- endif -%}
      </h1>

      {%- if shop.password_message != blank -%}
        <div class="ps-lede ps-coming__message" data-ps-reveal="up" style="--ps-delay:560ms">
          {{ shop.password_message }}
        </div>
      {%- elsif section.settings.body != blank -%}
        <p class="ps-lede ps-coming__message" data-ps-reveal="up" style="--ps-delay:560ms">
          {{ section.settings.body }}
        </p>
      {%- endif -%}

      {%- if section.settings.show_signup -%}
        <div class="ps-coming__signup" data-ps-reveal="up" style="--ps-delay:680ms">
          {% form 'customer', id: 'ps-coming-signup' %}
            {%- if form.posted_successfully? -%}
              <p class="ps-coming__ok" role="status">
                {% render 'icon', name: 'leaf', size: 18 %}
                {{ 'general.password_page.signup_success' | t | default: 'Thank you. We will write to you the day the shop opens.' }}
              </p>
            {%- else -%}
              <input type="hidden" name="contact[tags]" value="prospect, password-page">
              <div class="ps-coming__row">
                <p class="ps-field">
                  <input
                    class="ps-input"
                    type="email"
                    id="ps-coming-email"
                    name="contact[email]"
                    value="{{ form.email | escape }}"
                    autocomplete="email"
                    autocapitalize="off"
                    spellcheck="false"
                    placeholder=" "
                    required>
                  <label class="ps-label" for="ps-coming-email">
                    {{ 'general.password_page.signup_label' | t | default: 'Your email' }}
                  </label>
                </p>
                <button class="ps-btn ps-btn--sm" type="submit">
                  {{ section.settings.signup_cta | default: 'Tell me when' }}
                </button>
              </div>

              {%- if form.errors -%}
                <p class="ps-coming__error" role="alert">
                  {{ form.errors.messages.form | default: 'That address did not go through.' }}
                </p>
              {%- endif -%}
            {%- endif -%}
          {% endform %}
        </div>
      {%- endif -%}

      {%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_facebook != blank or settings.social_whatsapp != blank -%}
        <div class="ps-coming__social" data-ps-reveal="fade" style="--ps-delay:800ms">
          {%- if settings.social_instagram != blank -%}
            <a class="ps-contact__icon" href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              {% render 'icon', name: 'instagram', size: 19 %}
            </a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a class="ps-contact__icon" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
              {% render 'icon', name: 'tiktok', size: 19 %}
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a class="ps-contact__icon" href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
              {% render 'icon', name: 'facebook', size: 19 %}
            </a>
          {%- endif -%}
          {%- if settings.social_whatsapp != blank -%}
            <a class="ps-contact__icon" href="https://wa.me/{{ settings.social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">
              {% render 'icon', name: 'whatsapp', size: 19 %}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="ps-coming__figure" data-ps-parallax="0.07">
      <div class="ps-plate ps-coming__plate" data-ps-rotate="{{ section.settings.rotation }}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              widths: '420,640,900,1200,1400',
              sizes: '(max-width: 900px) 74vw, 40vw',
              alt: section.settings.image.alt | default: shop.name | escape
          }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'ps-coming__ph' }}
        {%- endif -%}
      </div>
      <span class="ps-plate-shadow" aria-hidden="true"></span>
    </div>

  </div>
</section>

{% stylesheet %}
  .ps-coming {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(84svh, 900px);
    padding-block: clamp(2.5rem, 7vw, 6rem);
    overflow: hidden;
    isolation: isolate;
  }
  .ps-coming__wash {
    position: absolute;
    inset: -25%;
    z-index: -1;
    background:
      radial-gradient(52% 48% at 16% 14%, var(--ps-wash, var(--ps-linen-warm)), transparent 64%),
      radial-gradient(46% 44% at 88% 84%, var(--ps-wash, var(--ps-linen-warm)), transparent 62%);
    opacity: 0.9;
    filter: blur(22px);
  }

  .ps-coming__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    width: 100%;
  }

  .ps-coming__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.9rem, 2vw, 1.5rem);
  }

  .ps-coming__title {
    font-family: var(--ps-display);
    font-size: clamp(2.6rem, 7.4vw, 5.6rem);
    font-weight: 250;
    font-variation-settings: "SOFT" 48, "WONK" 1, "opsz" 144;
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .ps-coming__message { max-width: 42ch; }
  .ps-coming__message p + p { margin-top: 0.7em; }

  .ps-coming__signup { width: min(100%, 30rem); }
  .ps-coming__row { display: flex; align-items: flex-end; gap: var(--ps-s-s); }
  .ps-coming__row .ps-field { flex: 1; }
  .ps-coming__ok {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-size: var(--ps-step--1);
    color: var(--ps-ink);
  }
  .ps-coming__ok svg { color: var(--ps-accent); flex: none; }
  .ps-coming__error {
    margin-top: var(--ps-s-2xs);
    font-size: var(--ps-step--1);
    color: var(--ps-coral-deep);
  }

  .ps-coming__social { display: flex; gap: var(--ps-s-2xs); margin-top: var(--ps-s-2xs); }

  .ps-coming__figure {
    position: relative;
    width: min(100%, 34rem);
    aspect-ratio: 1;
    justify-self: center;
    transform: translate3d(0, var(--ps-par, 0px), 0);
  }
  .ps-coming__plate { width: 100%; box-shadow: 0 30px 80px rgba(120, 95, 60, 0.22); }
  .ps-coming__ph { width: 100%; height: 100%; }

  @media (max-width: 900px) {
    .ps-coming__inner { grid-template-columns: 1fr; }
    .ps-coming__figure { order: -1; width: min(74%, 22rem); }
  }
  @media (max-width: 480px) {
    .ps-coming__row { flex-wrap: wrap; }
    .ps-coming__row .ps-btn { width: 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Cairo · Hand painted porcelain" },
    { "type": "text", "id": "line_1", "label": "Headline line 1", "default": "The kiln" },
    { "type": "text", "id": "line_2", "label": "Headline line 2", "default": "is still" },
    { "type": "text", "id": "line_3", "label": "Headline line 3", "default": "warm" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Copy",
      "info": "Used only when no password message is set in Shopify admin.",
      "default": "Three collections are being painted right now. Leave an email and we will tell you the day the shop opens."
    },
    { "type": "image_picker", "id": "image", "label": "Plate image (square works best)" },
    {
      "type": "range",
      "id": "rotation",
      "label": "Scroll rotation",
      "min": 0, "max": 120, "step": 5, "unit": "°", "default": 30
    },
    { "type": "checkbox", "id": "show_signup", "label": "Show the email signup", "default": true },
    { "type": "text", "id": "signup_cta", "label": "Signup button", "default": "Tell me when" },
    {
      "type": "select",
      "id": "pigment",
      "label": "Pigment",
      "options": [
        { "value": "none", "label": "Linen (default)" },
        { "value": "wild", "label": "Stitches of the Wild" },
        { "value": "beads", "label": "A Tale in Beads" },
        { "value": "past", "label": "Pretty Past" }
      ],
      "default": "beads"
    }
  ]
}
{% endschema %}
