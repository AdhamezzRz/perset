{%- comment -%}
  THE MAKING

  A numbered account of how a piece comes to exist, with the imagery drifting
  at a different speed to the text so the column feels like it is being read
  rather than scrolled past.
{%- endcomment -%}

<section class="ps-craft ps-section{% if section.settings.dark %} ps-dark{% endif %}">
  <div class="ps-shell ps-shell--wide">

    <div class="ps-craft__grid">

      <div class="ps-craft__aside">
        <div class="ps-craft__sticky">
          {%- if section.settings.eyebrow != blank -%}
            <p class="ps-eyebrow" data-ps-reveal="fade">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="ps-h2 ps-craft__title" data-ps-split="lines">{{ section.settings.heading }}</h2>
          {%- if section.settings.body != blank -%}
            <p class="ps-lede" data-ps-reveal="up" style="--ps-delay:180ms">{{ section.settings.body }}</p>
          {%- endif -%}

          {%- if section.settings.image != blank -%}
            <figure class="ps-craft__figure ps-ratio ps-ratio--43 ps-zoom" data-ps-reveal="glaze" style="--ps-delay:260ms">
              {{
                section.settings.image
                | image_url: width: 1100
                | image_tag: loading: 'lazy', widths: '400,640,900,1100', sizes: '(max-width: 900px) 92vw, 38vw', alt: section.settings.image.alt | default: section.settings.heading | escape
              }}
            </figure>
          {%- endif -%}

          {%- if section.settings.cta_label != blank -%}
            <a class="ps-btn ps-btn--ghost" href="{{ section.settings.cta_url | default: routes.collections_url }}" data-ps-magnetic="0.18" data-ps-reveal="up" style="--ps-delay:340ms">
              {{ section.settings.cta_label }}
              {% render 'icon', name: 'arrow-right', size: 15 %}
            </a>
          {%- endif -%}
        </div>
      </div>

      <ol class="ps-craft__steps" data-ps-stagger="110">
        {%- for block in section.blocks -%}
          <li class="ps-craft__step" data-ps-reveal="up" {{ block.shopify_attributes }}>
            <div class="ps-craft__step-head">
              <span class="ps-craft__num ps-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              {%- if block.settings.icon != 'none' -%}
                <span class="ps-craft__icon">{% render 'icon', name: block.settings.icon, size: 20 %}</span>
              {%- endif -%}
            </div>
            <div class="ps-craft__step-body">
              <h3 class="ps-h4">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}
                <p>{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>

    </div>
  </div>
</section>

{% stylesheet %}
  .ps-craft { background: var(--ps-linen-warm); }
  .ps-craft.ps-dark { background: var(--ps-ink); }

  .ps-craft__grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .ps-craft__sticky {
    position: sticky;
    top: calc(var(--ps-header-h) + 3vh);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ps-s-s);
  }
  .ps-craft__title { margin-top: 0.3rem; }
  .ps-craft__figure {
    width: 100%;
    border-radius: var(--ps-radius-l);
    margin-top: var(--ps-s-s);
  }

  .ps-craft__steps {
    display: flex;
    flex-direction: column;
  }
  .ps-craft__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--ps-s-m);
    padding-block: clamp(1.6rem, 3.4vw, 2.6rem);
    border-bottom: 1px solid var(--ps-hairline);
  }
  .ps-craft__step:first-child { padding-top: 0; }
  .ps-craft__step:last-child { border-bottom: 0; }
  .ps-dark .ps-craft__step { border-color: rgba(244, 238, 228, 0.16); }

  .ps-craft__step-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }
  .ps-craft__num {
    font-size: var(--ps-step-2);
    font-weight: 300;
    line-height: 1;
    color: var(--ps-accent);
    font-variation-settings: "SOFT" 30, "WONK" 1, "opsz" 72;
  }
  .ps-craft__icon {
    display: grid;
    place-items: center;
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 1px solid var(--ps-hairline);
    color: var(--ps-ink-soft);
  }
  .ps-dark .ps-craft__icon { border-color: rgba(244,238,228,0.22); color: var(--ps-linen); }

  .ps-craft__step-body { display: flex; flex-direction: column; gap: 0.45rem; }
  .ps-craft__step-body p {
    color: var(--ps-ink-soft);
    max-width: 52ch;
    text-wrap: pretty;
  }
  .ps-dark .ps-craft__step-body p { color: rgba(244,238,228,0.72); }

  @media (max-width: 900px) {
    .ps-craft__grid { grid-template-columns: 1fr; }
    .ps-craft__sticky { position: static; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "The making",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How a piece comes to be" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Drawn, painted, fired, twice" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Introduction",
      "default": "Nothing here is transferred or printed. Every line is laid down by a hand holding a brush, which is why the leopards on your plates will not match the leopards on anyone else's."
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Read our story" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "The drawing" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Each motif is drawn by hand first, at full size, until the composition sits right on a circle." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "brush", "label": "Brush" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "knot", "label": "Knot" },
            { "value": "box", "label": "Box" }
          ],
          "default": "brush"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "The making",
      "blocks": [
        { "type": "step", "settings": { "title": "The drawing", "icon": "brush", "text": "Each motif is drawn by hand first, at full size, until the composition sits right on a circle." } },
        { "type": "step", "settings": { "title": "The painting", "icon": "leaf", "text": "Colour goes on in layers over the bisque. The stitched borders are the slowest part, laid stitch by stitch around the rim." } },
        { "type": "step", "settings": { "title": "The firing", "icon": "knot", "text": "Two firings. The first sets the body, the second fixes the glaze and brings the colour up to its final depth." } },
        { "type": "step", "settings": { "title": "The packing", "icon": "box", "text": "Wrapped by hand, boxed in sixes, and checked once more before it leaves the studio." } }
      ]
    }
  ]
}
{% endschema %}
