{%- comment -%}
  INSIDE THE SET

  A piece picker. Choose a collection, then choose one piece of the service
  — dinner, salad, soup, dessert — and see it alone, cropped the same way
  every time. No stack, no hover reveal: one plate, centred, at a time.
{%- endcomment -%}

{%- liquid
  assign sid = section.id | replace: '_', '-'
-%}

<section class="ps-setting ps-section" data-ps-setting id="setting-{{ sid }}">
  <div class="ps-shell ps-shell--wide">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.body != blank -%}
      <header class="ps-setting__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="ps-eyebrow" data-ps-reveal="fade">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="ps-h2 ps-setting__title" data-ps-split="lines">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.body != blank -%}
          <p class="ps-lede" data-ps-reveal="up">{{ section.settings.body }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 1 -%}
      <div class="ps-setting__tabs" role="tablist" aria-label="{{ 'sections.setting.choose' | t | default: 'Choose a collection' }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign col = collections[block.settings.collection]
            assign label = block.settings.label
            if label == blank
              assign label = col.title
            endif
          -%}
          <button
            class="ps-setting__tab{% if forloop.first %} is-active{% endif %}"
            role="tab"
            type="button"
            id="tab-{{ sid }}-{{ forloop.index }}"
            aria-controls="panel-{{ sid }}-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-ps-setting-tab="{{ forloop.index0 }}"
            data-pigment="{{ block.settings.pigment }}">
            <span class="ps-setting__swatch" aria-hidden="true" data-ps-pigment="{{ block.settings.pigment }}"></span>
            {{ label }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="ps-setting__stage-wrap">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign dinner  = all_products[block.settings.dinner]
          assign salad   = all_products[block.settings.salad]
          assign dessert = all_products[block.settings.dessert]
          assign soup    = all_products[block.settings.soup]
        -%}

        <div
          class="ps-setting__panel{% if forloop.first %} is-active{% endif %}"
          role="tabpanel"
          id="panel-{{ sid }}-{{ forloop.index }}"
          aria-labelledby="tab-{{ sid }}-{{ forloop.index }}"
          data-ps-pigment="{{ block.settings.pigment }}"
          data-ps-setting-panel="{{ forloop.index0 }}"
          {% unless forloop.first %}hidden{% endunless %}
          {{ block.shopify_attributes }}>

          <div class="ps-setting__cloth">
            {%- comment -%}
              Cutlery, drawn rather than photographed so it never competes
              with the porcelain.
            {%- endcomment -%}
            <svg class="ps-setting__cutlery ps-setting__cutlery--l" viewBox="0 0 24 200" aria-hidden="true">
              <path d="M12 196V78M7 8v44a5 5 0 0 0 10 0V8M12 8v44"/>
            </svg>
            <svg class="ps-setting__cutlery ps-setting__cutlery--r" viewBox="0 0 24 200" aria-hidden="true">
              <path d="M12 196V74M12 74c-6 0-8-8-8-26S8 8 12 8s8 22 8 40-2 26-8 26Z"/>
            </svg>

            <div class="ps-setting__picker">
              {%- comment -%}
                One piece shown alone, at a time — same square crop for every
                piece, in every collection. The picker below chooses which.
              {%- endcomment -%}
              {%- assign piece_keys = 'dinner,salad,soup,dessert' | split: ',' -%}

              <div class="ps-setting__stage">
                {%- assign piece_i = -1 -%}
                {%- for key in piece_keys -%}
                  {%- liquid
                    case key
                      when 'dinner'
                        assign piece = dinner
                        assign piece_label = 'sections.setting.dinner' | t | default: 'Dinner'
                        assign piece_cm = '27 cm'
                      when 'salad'
                        assign piece = salad
                        assign piece_label = 'sections.setting.salad' | t | default: 'Salad'
                        assign piece_cm = '21 cm'
                      when 'soup'
                        assign piece = soup
                        assign piece_label = 'sections.setting.soup' | t | default: 'Soup'
                        assign piece_cm = '12 cm'
                      when 'dessert'
                        assign piece = dessert
                        assign piece_label = 'sections.setting.dessert' | t | default: 'Dessert'
                        assign piece_cm = '21 cm'
                    endcase
                  -%}
                  {%- if piece == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign piece_i = piece_i | plus: 1 -%}
                  {%- assign piece_alt = piece.title | escape -%}
                  {%- comment -%}
                    Pieces are not sold on their own, so this points at the
                    collection's one full-set product rather than the piece's
                    own product page.
                  {%- endcomment -%}
                  <a
                    class="ps-setting__piece{% if piece_i == 0 %} is-active{% endif %}"
                    href="{{ col.url | default: routes.collections_url }}"
                    data-ps-piece-panel="{{ piece_i }}"
                    data-ps-cursor="{{ piece_label }}">
                    {{
                      piece.featured_media
                      | image_url: width: 1000
                      | image_tag:
                        loading: 'lazy',
                        widths: '400,640,900,1000',
                        sizes: '(max-width: 760px) 76vw, 32vw',
                        alt: piece_alt,
                        class: 'ps-setting__piece-img'
                    }}
                  </a>
                {%- endfor -%}
              </div>

              <div class="ps-setting__piece-tabs" role="tablist" aria-label="{{ 'sections.setting.choose_piece' | t | default: 'Choose a piece' }}">
                {%- assign piece_i = -1 -%}
                {%- for key in piece_keys -%}
                  {%- liquid
                    case key
                      when 'dinner'
                        assign piece = dinner
                        assign piece_label = 'sections.setting.dinner' | t | default: 'Dinner'
                        assign piece_cm = '27 cm'
                      when 'salad'
                        assign piece = salad
                        assign piece_label = 'sections.setting.salad' | t | default: 'Salad'
                        assign piece_cm = '21 cm'
                      when 'soup'
                        assign piece = soup
                        assign piece_label = 'sections.setting.soup' | t | default: 'Soup'
                        assign piece_cm = '12 cm'
                      when 'dessert'
                        assign piece = dessert
                        assign piece_label = 'sections.setting.dessert' | t | default: 'Dessert'
                        assign piece_cm = '21 cm'
                    endcase
                  -%}
                  {%- if piece == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign piece_i = piece_i | plus: 1 -%}
                  <button
                    class="ps-setting__piece-tab{% if piece_i == 0 %} is-active{% endif %}"
                    type="button"
                    role="tab"
                    aria-selected="{% if piece_i == 0 %}true{% else %}false{% endif %}"
                    data-ps-piece-tab="{{ piece_i }}">
                    <b>{{ piece_label }}</b><span>{{ piece_cm }}</span>
                  </button>
                {%- endfor -%}
              </div>
            </div>
          </div>

          <aside class="ps-setting__note">
            <h3 class="ps-h4">{{ block.settings.label | default: col.title }}</h3>
            {%- if block.settings.note != blank -%}
              <p>{{ block.settings.note }}</p>
            {%- endif -%}
            <ul class="ps-setting__list">
              <li><span>{{ 'sections.setting.dinner' | t | default: 'Dinner plates' }}</span><span class="ps-num">6 × 27 cm</span></li>
              <li><span>{{ 'sections.setting.dessert' | t | default: 'Dessert plates' }}</span><span class="ps-num">6 × 21 cm</span></li>
              <li><span>{{ 'sections.setting.salad' | t | default: 'Salad plates' }}</span><span class="ps-num">6 × 21 cm</span></li>
              <li><span>{{ 'sections.setting.soup' | t | default: 'Soup bowls' }}</span><span class="ps-num">6 × 12 cm</span></li>
            </ul>
            {% render 'icon', name: 'thread', draw: true %}
            <a class="ps-btn ps-btn--ghost" href="{{ col.url | default: routes.collections_url }}" data-ps-magnetic="0.18">
              {{ block.settings.cta | default: 'See the full service' }}
              {% render 'icon', name: 'arrow-right', size: 15 %}
            </a>
          </aside>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .ps-setting { background: var(--ps-linen); overflow: hidden; }

  .ps-setting__head {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--ps-s-l);
    align-items: end;
    margin-bottom: clamp(1.8rem, 4vw, 3rem);
  }
  .ps-setting__title { margin-top: 0.4rem; }
  @media (max-width: 860px) {
    .ps-setting__head { grid-template-columns: 1fr; gap: var(--ps-s-s); }
  }

  .ps-setting__tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding-bottom: var(--ps-s-m);
    border-bottom: 1px solid var(--ps-hairline);
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .ps-setting__tab {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.62em 1.15em;
    border-radius: 999px;
    border: 1px solid var(--ps-hairline);
    font-size: var(--ps-step--1);
    letter-spacing: 0.07em;
    color: var(--ps-ink-soft);
    transition: color var(--ps-t-fast) var(--ps-ease-swap),
                border-color var(--ps-t-fast) var(--ps-ease-swap),
                background var(--ps-t-fast) var(--ps-ease-swap);
  }
  .ps-setting__tab:hover { border-color: var(--ps-ink-faint); color: var(--ps-ink); }
  .ps-setting__tab.is-active {
    background: var(--ps-ink);
    border-color: var(--ps-ink);
    color: var(--ps-porcelain);
  }
  .ps-setting__swatch {
    width: 13px; height: 13px;
    border-radius: 50%;
    background: var(--ps-accent);
    box-shadow: 0 0 0 1px rgba(255,255,255,0.35) inset;
    flex: none;
  }

  .ps-setting__stage-wrap { position: relative; }

  .ps-setting__panel {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  .ps-setting__panel[hidden] { display: none; }

  /* The cloth: a pigment-washed round table top */
  .ps-setting__cloth {
    position: relative;
    min-height: clamp(26rem, 32vw, 36rem);
    padding-block: clamp(2rem, 4vw, 3rem);
    display: grid;
    place-items: center;
    border-radius: var(--ps-radius-l);
    background:
      radial-gradient(75% 75% at 50% 46%, var(--ps-wash, var(--ps-linen-warm)), transparent 72%),
      var(--ps-linen-warm);
  }
  .ps-setting__cloth::before {
    content: "";
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    border: 1px dashed var(--ps-hairline);
    opacity: 0.8;
  }

  .ps-setting__cutlery {
    position: absolute;
    top: 50%;
    width: clamp(14px, 1.7vw, 22px);
    height: auto;
    aspect-ratio: 24 / 200;
    transform: translateY(-50%);
    fill: none;
    stroke: var(--ps-ink-faint);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.55;
  }
  .ps-setting__cutlery--l { left: 4%; }
  .ps-setting__cutlery--r { right: 4%; transform: translateY(-50%) scaleX(-1); }

  .ps-setting__picker {
    position: relative;
    width: 78%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.1rem, 2.4vw, 1.7rem);
  }

  /* The stage: one square crop, always the same shape, whichever piece
     is showing. */
  .ps-setting__stage {
    position: relative;
    width: min(100%, 30rem);
    aspect-ratio: 1;
  }
  .ps-setting__piece {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 20px 48px rgba(120, 95, 60, 0.22);
    opacity: 0;
    transform: scale(0.94);
    pointer-events: none;
    transition: opacity var(--ps-t-base) var(--ps-ease-set),
                transform var(--ps-t-base) var(--ps-ease-set);
  }
  .ps-setting__piece.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .ps-setting__piece-img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .ps-setting__piece-tabs {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .ps-setting__piece-tab {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    padding: 0.55em 1.05em;
    border-radius: 999px;
    border: 1px solid var(--ps-hairline);
    background: var(--ps-linen);
    font-size: var(--ps-step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ps-ink-soft);
    transition: color var(--ps-t-fast) var(--ps-ease-swap),
                border-color var(--ps-t-fast) var(--ps-ease-swap),
                background var(--ps-t-fast) var(--ps-ease-swap);
  }
  .ps-setting__piece-tab span { opacity: 0.7; font-size: 0.92em; }
  .ps-setting__piece-tab:hover { border-color: var(--ps-ink-faint); color: var(--ps-ink); }
  .ps-setting__piece-tab.is-active {
    background: var(--ps-ink);
    border-color: var(--ps-ink);
    color: var(--ps-porcelain);
  }

  .ps-setting__note {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--ps-s-s);
  }
  .ps-setting__note p { color: var(--ps-ink-soft); max-width: 38ch; }
  .ps-setting__list {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-block: 0.4rem;
  }
  .ps-setting__list li {
    display: flex;
    justify-content: space-between;
    gap: var(--ps-s-s);
    padding: 0.62rem 0;
    border-bottom: 1px solid var(--ps-hairline-soft);
    font-size: var(--ps-step--1);
  }
  .ps-setting__list li span:first-child { color: var(--ps-ink-soft); }

  @media (max-width: 900px) {
    .ps-setting__panel { grid-template-columns: 1fr; }
    .ps-setting__picker { width: 84%; }
    .ps-setting__cutlery { display: none; }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.getElementById('setting-{{ sid }}');
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-ps-setting-tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-ps-setting-panel]'));
    if (!tabs.length) return;

    function show(i) {
      tabs.forEach(function (t, n) {
        var on = n === i;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach(function (p, n) {
        if (n === i) {
          p.hidden = false;
          // Re-run the arrival animation each time a setting is laid.
          p.classList.add('is-entering');
          p.classList.remove('is-active');
          void p.offsetWidth;
          p.classList.remove('is-entering');
          p.classList.add('is-active');
        } else {
          p.hidden = true;
          p.classList.remove('is-active');
        }
      });
    }

    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { show(i); });
      t.addEventListener('keydown', function (e) {
        var n = null;
        if (e.key === 'ArrowRight') n = (i + 1) % tabs.length;
        if (e.key === 'ArrowLeft') n = (i - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') n = 0;
        if (e.key === 'End') n = tabs.length - 1;
        if (n === null) return;
        e.preventDefault();
        tabs[n].focus();
        show(n);
      });
    });

    // Within each collection panel, choosing a piece swaps which one shows
    // on the stage. Scoped per panel so several collections never cross-fire.
    panels.forEach(function (panel) {
      var pieceTabs = Array.prototype.slice.call(panel.querySelectorAll('[data-ps-piece-tab]'));
      var pieces = Array.prototype.slice.call(panel.querySelectorAll('[data-ps-piece-panel]'));
      if (!pieceTabs.length) return;

      function showPiece(i) {
        pieceTabs.forEach(function (t, n) {
          var on = n === i;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        pieces.forEach(function (p, n) { p.classList.toggle('is-active', n === i); });
      }

      pieceTabs.forEach(function (t, i) {
        t.addEventListener('click', function () { showPiece(i); });
      });
    });

    // Lay the first setting when the section scrolls into view.
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (!en.isIntersecting) return;
          en.target.classList.add('is-in');
          io.unobserve(en.target);
        });
      }, { threshold: 0.2 });
      panels.forEach(function (p) { io.observe(p); });
    } else {
      panels.forEach(function (p) { p.classList.add('is-in'); });
    }
  })();
</script>

{% schema %}
{
  "name": "Set your table",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Inside the Set" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Set your table" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Introduction",
      "default": "Everything you need to set a table of six, choose a plate and explore."
    }
  ],
  "blocks": [
    {
      "type": "setting",
      "name": "Collection setting",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label" },
        { "type": "textarea", "id": "note", "label": "Note" },
        { "type": "text", "id": "cta", "label": "Button label", "default": "See the full service" },
        {
          "type": "select",
          "id": "pigment",
          "label": "Pigment",
          "options": [
            { "value": "wild", "label": "Stitches of the Wild" },
            { "value": "beads", "label": "A Tale in Beads" },
            { "value": "past", "label": "Pretty Past" }
          ],
          "default": "wild"
        },
        { "type": "header", "content": "The four pieces" },
        { "type": "product", "id": "dinner", "label": "Dinner plates (27 cm)" },
        { "type": "product", "id": "dessert", "label": "Dessert plates (21 cm)" },
        { "type": "product", "id": "salad", "label": "Salad plates (21 cm)" },
        { "type": "product", "id": "soup", "label": "Soup bowls (12 cm)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Set your table",
      "blocks": [
        { "type": "setting", "settings": { "pigment": "wild" } },
        { "type": "setting", "settings": { "pigment": "beads" } },
        { "type": "setting", "settings": { "pigment": "past" } }
      ]
    }
  ]
}
{% endschema %}
