{%- comment -%}
  A running band of text with a French knot between each phrase. Pauses on
  hover so anyone who wants to read it, can.
{%- endcomment -%}

<div
  class="ps-marquee{% if section.settings.reverse %} ps-marquee--reverse{% endif %}{% if section.settings.dark %} ps-dark{% endif %}"
  style="--ps-marquee-dur: {{ section.settings.speed }}s;"
  role="marquee"
  aria-label="{{ section.settings.aria | default: 'Announcements' | escape }}">
  <div class="ps-marquee__track">
    <div class="ps-marquee__group">
      {%- for block in section.blocks -%}
        {%- if block.type == 'mark' -%}
          <span class="ps-marquee__item ps-marquee__item--mark" {{ block.shopify_attributes }}>
            {% render 'logo', width: 'clamp(64px, 6vw, 92px)' %}
          </span>
        {%- else -%}
          <span class="ps-marquee__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- endif -%}
        {% render 'icon', name: 'knot', size: 16 %}
      {%- else -%}
        {%- assign fallback = 'Made in Egypt · Three collections · Complete sets of 24' | split: ' · ' -%}
        {%- for item in fallback -%}
          <span class="ps-marquee__item">{{ item }}</span>
          {% render 'icon', name: 'knot', size: 16 %}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .ps-marquee.ps-dark {
    background: var(--ps-ink);
    border-color: rgba(244, 238, 228, 0.16);
  }
  .ps-marquee.ps-dark .ps-marquee__item { color: var(--ps-linen); }
  .ps-marquee .ps-knot { color: var(--ps-accent); }
  .ps-marquee__item--mark { display: inline-flex; align-items: center; color: currentColor; }
  .ps-marquee__item--mark .ps-logomark { display: block; }
{% endstylesheet %}

{% schema %}
{
  "name": "Marquee",
  "tag": "div",
  "max_blocks": 10,
  "settings": [
    { "type": "range", "id": "speed", "label": "Duration", "min": 16, "max": 90, "step": 2, "unit": "s", "default": 44 },
    { "type": "checkbox", "id": "reverse", "label": "Run right to left", "default": false },
    { "type": "checkbox", "id": "dark", "label": "Dark band", "default": false },
    { "type": "text", "id": "aria", "label": "Accessible label", "default": "Brand notes" }
  ],
  "blocks": [
    {
      "type": "phrase",
      "name": "Phrase",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Made in Egypt" }]
    },
    {
      "type": "mark",
      "name": "Logo mark",
      "settings": [{ "type": "paragraph", "content": "Renders the per set logomark in place of text." }]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "phrase", "settings": { "text": "Made in Egypt" } },
        { "type": "phrase", "settings": { "text": "Three collections" } },
        { "type": "phrase", "settings": { "text": "Complete sets of 24" } },
        { "type": "phrase", "settings": { "text": "Cairo, Egypt" } },
        { "type": "mark" }
      ]
    }
  ]
}
{% endschema %}
