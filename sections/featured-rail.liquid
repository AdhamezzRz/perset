{%- comment -%}
  A horizontal rail of products. Scrolls with the wheel or a drag, snaps to
  each card, and reports its position to a thread indicator underneath.
{%- endcomment -%}

{%- liquid
  assign col = collections[section.settings.collection]
  assign items = col.products
  assign count = section.settings.count
-%}

<section class="ps-rail-sec ps-section{% if section.settings.dark %} ps-dark{% endif %}">
  <div class="ps-shell ps-shell--wide">
    <header class="ps-rail__head">
      <div class="ps-rail__headings">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ps-eyebrow" data-ps-reveal="fade">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="ps-h3 ps-rail__title" data-ps-split="lines">
          {{ section.settings.heading | default: col.title }}
        </h2>
      </div>

      <div class="ps-rail__controls">
        {%- if col != blank -%}
          <a class="ps-link ps-hide@sm" href="{{ col.url }}">
            {{ section.settings.view_all | default: 'View all' }}
            {% render 'icon', name: 'arrow-right', size: 15 %}
          </a>
        {%- endif -%}
        <button class="ps-icon-btn ps-rail__btn" type="button" data-ps-rail-prev aria-label="{{ 'general.previous' | t | default: 'Previous' }}">
          {% render 'icon', name: 'arrow-left', size: 18 %}
        </button>
        <button class="ps-icon-btn ps-rail__btn" type="button" data-ps-rail-next aria-label="{{ 'general.next' | t | default: 'Next' }}">
          {% render 'icon', name: 'arrow-right', size: 18 %}
        </button>
      </div>
    </header>
  </div>

  <div class="ps-rail__outer">
    <ul class="ps-rail" data-ps-rail data-ps-stagger="80">
      {%- if items.size > 0 -%}
        {%- for product in items limit: count -%}
          <li class="ps-rail__item">
            {% render 'product-card', product: product, reveal: 'set' %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="ps-rail__item">
            <article class="ps-card" data-ps-reveal="set">
              <div class="ps-card__frame">
                <span class="ps-card__ring" aria-hidden="true"></span>
                <div class="ps-card__media">{{ 'product-1' | placeholder_svg_tag: '' }}</div>
              </div>
              <div class="ps-card__body">
                <h3 class="ps-card__title">{{ 'onboarding.product_title' | t | default: 'Example piece' }}</h3>
                <p class="ps-card__price">{{ 1999 | money }}</p>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    <div class="ps-shell ps-shell--wide">
      <div class="ps-rail__bar" aria-hidden="true">
        <span class="ps-rail__bar-fill" data-ps-rail-bar></span>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ps-rail-sec { overflow: hidden; }
  .ps-rail-sec.ps-dark { background: var(--ps-ink); }

  .ps-rail__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--ps-s-m);
    flex-wrap: wrap;
    margin-bottom: clamp(1.5rem, 3.5vw, 2.75rem);
  }
  .ps-rail__title { margin-top: 0.35rem; }
  .ps-rail__controls { display: flex; align-items: center; gap: 0.6rem; }
  .ps-rail__btn {
    border: 1px solid var(--ps-hairline);
  }
  .ps-dark .ps-rail__btn { border-color: rgba(244,238,228,0.25); }
  .ps-dark .ps-icon-btn:hover { background: rgba(244,238,228,0.1); }

  .ps-rail {
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--ps-gutter);
    padding-inline: var(--ps-gutter);
    padding-bottom: var(--ps-s-m);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
  }
  .ps-rail::-webkit-scrollbar { display: none; }

  .ps-rail__item {
    flex: 0 0 auto;
    width: clamp(232px, 25vw, 340px);
    scroll-snap-align: start;
  }

  .ps-rail__bar {
    position: relative;
    height: 1px;
    background: var(--ps-hairline);
    margin-top: var(--ps-s-s);
    overflow: hidden;
  }
  .ps-dark .ps-rail__bar { background: rgba(244,238,228,0.2); }
  .ps-rail__bar-fill {
    position: absolute;
    inset: 0;
    background: var(--ps-accent);
    transform-origin: left center;
    /* The fill tracks the rail's scroll position, reported by the motion engine. */
    transform: translateX(calc(var(--ps-progress, 0) * 76%)) scaleX(0.24);
    transition: transform 140ms linear;
  }

  @media (max-width: 640px) {
    .ps-rail__item { width: 72vw; }
    .ps-rail__head { align-items: flex-start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product rail",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pieces to start with" },
    { "type": "text", "id": "view_all", "label": "View all label", "default": "View all" },
    { "type": "range", "id": "count", "label": "Products shown", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "presets": [{ "name": "Product rail" }]
}
{% endschema %}
