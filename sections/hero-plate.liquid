{%- comment -%}
  THE BRAND STATEMENT

  Oxblood ground with a blush stripe band top and bottom like a ticket
  edge, the hand-lettered mark, and a two-line statement that lands on
  the brand's own name — now with a looping video of a table being laid
  behind it all, muted and cropped to fill the frame, with a warm oxblood
  scrim over it so the type stays legible and the mood stays the brand's
  own rather than the footage's. Falls back to a still poster image for
  anyone who has asked their device to reduce motion, and to plain
  oxblood when no video is set at all.
{%- endcomment -%}

<section class="ps-hero-brand{% if section.settings.video_url != blank %} ps-hero-brand--video{% endif %}" data-ps-reveal-group{% if section.settings.video_url != blank %} data-ps-hero-video-wrap{% endif %}>
  {%- if section.settings.video_url != blank -%}
    <div class="ps-hero-brand__media" aria-hidden="true" style="{% if section.settings.video_poster_url != blank %}background-image: url('{{ section.settings.video_poster_url }}');{% endif %}">
      <video
        class="ps-hero-brand__video"
        data-ps-hero-video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        {% if section.settings.video_poster_url != blank %}poster="{{ section.settings.video_poster_url }}"{% endif %}>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    </div>
    <div class="ps-hero-brand__scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="ps-hero-brand__stripes ps-hero-brand__stripes--top" aria-hidden="true"></div>

  <div class="ps-shell ps-shell--wide ps-hero-brand__inner">

    {%- if section.settings.show_mark -%}
      <div class="ps-hero-brand__mark" data-ps-reveal="fade">
        {% render 'logo', width: 'clamp(96px, 12vw, 160px)' %}
      </div>
    {%- endif -%}

    <h1 class="ps-hero-brand__title">
      {%- if section.settings.headline_1 != blank -%}
        <span class="ps-hero-brand__line">
          <span class="ps-line-mask"><span class="ps-line-inner ps-lines is-in" style="--ps-delay:80ms">{{ section.settings.headline_1 }}</span></span>
        </span>
      {%- endif -%}
      {%- if section.settings.headline_2 != blank -%}
        <span class="ps-hero-brand__line ps-hero-brand__line--em">
          <span class="ps-line-mask"><span class="ps-line-inner ps-lines is-in" style="--ps-delay:220ms">{{ section.settings.headline_2 }}</span></span>
        </span>
      {%- endif -%}
    </h1>

    {%- if section.settings.lede != blank -%}
      <p class="ps-hero-brand__lede" data-ps-reveal="up" style="--ps-delay:420ms">{{ section.settings.lede }}</p>
    {%- endif -%}

    {%- if section.settings.show_spark -%}
      <div class="ps-hero-brand__spark" data-ps-reveal="scale" style="--ps-delay:540ms" aria-hidden="true">
        {% render 'icon', name: 'spark', size: 26 %}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
      <div class="ps-hero-brand__actions" data-ps-reveal="up" style="--ps-delay:620ms">
        {%- if section.settings.cta_label != blank -%}
          <a class="ps-btn ps-btn--light" href="{{ section.settings.cta_url | default: '/collections/frontpage' }}" data-ps-magnetic="0.22">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="ps-link" href="{{ section.settings.cta2_url | default: routes.collections_url }}">
            {{ section.settings.cta2_label }}
            {% render 'icon', name: 'arrow-right', size: 15 %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.scroll_cue != blank -%}
    <div class="ps-hero-brand__cue" data-ps-reveal="fade" style="--ps-delay:900ms" aria-hidden="true">
      <span>{{ section.settings.scroll_cue }}</span>
      <span class="ps-hero-brand__cue-line"></span>
    </div>
  {%- endif -%}

  <div class="ps-hero-brand__stripes ps-hero-brand__stripes--bottom" aria-hidden="true"></div>
</section>

{% stylesheet %}
  .ps-hero-brand {
    position: relative;
    min-height: min(92svh, 940px);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ps-oxblood);
    color: var(--ps-blush);
    overflow: hidden;
    isolation: isolate;
  }

  /* The video sits behind everything, cropped to fill the frame, with a
     warm oxblood scrim over it so the mood stays the brand's own and the
     type never fights the footage for attention. */
  .ps-hero-brand__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--ps-oxblood);
    background-size: cover;
    background-position: center;
  }
  .ps-hero-brand__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ps-hero-brand__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(180deg, rgba(80, 12, 2, 0.72) 0%, rgba(80, 12, 2, 0.32) 26%, rgba(80, 12, 2, 0.32) 74%, rgba(80, 12, 2, 0.75) 100%),
      rgba(80, 12, 2, 0.28);
  }
  /* No video: the still oxblood ground, same as before. Reduced motion:
     the video is removed from the DOM by script before it can play, and
     this same still ground (plus the poster, if one is set) is what is
     left showing — never a frozen or auto-playing frame either way. */
  .ps-hero-brand--video:not(.is-video-ready) .ps-hero-brand__video { opacity: 0; }
  .ps-hero-brand--video.is-video-ready .ps-hero-brand__video {
    opacity: 1;
    transition: opacity 900ms var(--ps-ease-set);
  }
  @media (prefers-reduced-motion: reduce) {
    .ps-hero-brand__video { display: none; }
  }

  .ps-hero-brand__stripes {
    position: absolute;
    z-index: 1;
    left: 0; right: 0;
    height: clamp(28px, 4.6vw, 56px);
    background-image: repeating-linear-gradient(
      90deg,
      var(--ps-blush) 0 clamp(18px, 3.2vw, 36px),
      transparent clamp(18px, 3.2vw, 36px) clamp(42px, 7vw, 82px)
    );
  }
  .ps-hero-brand__stripes--top { top: 0; }
  .ps-hero-brand__stripes--bottom { bottom: 0; }

  .ps-hero-brand__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.4rem);
    text-align: center;
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .ps-hero-brand__mark { color: var(--ps-blush); }
  .ps-hero-brand__mark .ps-logomark { display: block; }

  .ps-hero-brand__title {
    margin: 0;
    max-width: 100%;
    font-family: var(--ps-display);
    font-weight: 300;
    text-transform: uppercase;
    line-height: 1.04;
    letter-spacing: -0.01em;
  }
  .ps-hero-brand__line { display: block; overflow: hidden; max-width: 100%; }
  .ps-hero-brand__line .ps-line-inner { display: block; overflow-wrap: break-word; }
  .ps-hero-brand__line:first-child {
    font-size: clamp(1.5rem, 5.4vw, 3.6rem);
    font-variation-settings: "SOFT" 30, "WONK" 0, "opsz" 80;
    letter-spacing: 0.02em;
  }
  /* The second line lands on the brand's own name, so it gets the full
     hand-lettered treatment: italic, larger, softer. */
  .ps-hero-brand__line--em {
    font-style: italic;
    font-size: clamp(2rem, 9vw, 6.4rem);
    font-variation-settings: "SOFT" 55, "WONK" 1, "opsz" 144;
    letter-spacing: -0.02em;
    margin-top: 0.08em;
  }
  @media (max-width: 420px) {
    .ps-hero-brand__line:first-child { font-size: clamp(1.3rem, 6.6vw, 1.9rem); }
    .ps-hero-brand__line--em { font-size: clamp(1.7rem, 10.5vw, 2.6rem); }
  }

  .ps-hero-brand__lede {
    max-width: 42ch;
    color: rgba(242, 164, 182, 0.82);
    font-size: var(--ps-step-1);
    line-height: 1.55;
    margin-top: 0.3rem;
  }

  .ps-hero-brand__spark { color: var(--ps-blush); margin-top: 0.2rem; }

  .ps-hero-brand__actions {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.2rem);
    flex-wrap: wrap;
    justify-content: center;
    color: var(--ps-blush);
    margin-top: clamp(0.6rem, 2vw, 1.2rem);
  }

  .ps-hero-brand__cue {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: clamp(1.6rem, 4vh, 3rem);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    font-size: var(--ps-step--2);
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: rgba(242, 164, 182, 0.65);
  }
  .ps-hero-brand__cue-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, currentColor, transparent);
    transform-origin: top center;
    animation: ps-cue 2.6s var(--ps-ease-swap) infinite;
  }
  @keyframes ps-cue {
    0%   { transform: scaleY(0); opacity: 0; }
    35%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1) translateY(40px); opacity: 0; }
  }

  @media (max-width: 640px) {
    .ps-hero-brand { min-height: auto; }
    .ps-hero-brand__cue { display: none; }
  }
{% endstylesheet %}

{%- if section.settings.video_url != blank -%}
<script>
  (function () {
    var root = document.currentScript.closest('[data-ps-hero-video-wrap]');
    if (!root) return;
    var video = root.querySelector('[data-ps-hero-video]');
    if (!video) return;

    // A person who has asked their whole device to reduce motion never
    // gets an autoplaying video, whatever the browser does with a
    // display:none element — the still poster underneath is the ceiling.
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    video.addEventListener('loadeddata', function () {
      root.classList.add('is-video-ready');
    });
    // Autoplay can be blocked (data saver, a strict browser setting); the
    // still poster is already showing underneath, so a blocked play is a
    // silent, harmless no-op rather than an error.
    var playPromise = video.play();
    if (playPromise && playPromise.catch) { playPromise.catch(function () {}); }

    // Pause off-screen so a visitor scrolling past the hero once isn't
    // quietly decoding video for the rest of the visit.
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            var p = video.play();
            if (p && p.catch) { p.catch(function () {}); }
          } else {
            video.pause();
          }
        });
      }, { threshold: 0.1 });
      io.observe(root);
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Hero — brand stripe",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Oxblood ground with the stripe band from the thank-you card. A looping video plays behind it all when one is set below; leave it blank for the plain oxblood ground."
    },
    { "type": "checkbox", "id": "show_mark", "label": "Show the logomark", "default": true },
    { "type": "text", "id": "headline_1", "label": "Headline line 1", "default": "Beautiful per piece" },
    { "type": "text", "id": "headline_2", "label": "Headline line 2 (the emphasised line)", "default": "perfect per set" },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Introduction"
    },
    { "type": "checkbox", "id": "show_spark", "label": "Show the sunburst flourish", "default": true },
    { "type": "header", "content": "Video background (optional)" },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (.mp4)",
      "info": "Muted, looping, cropped to fill the frame. Removed automatically for anyone who has asked their device to reduce motion."
    },
    {
      "type": "url",
      "id": "video_poster_url",
      "label": "Poster image URL",
      "info": "Shown instantly, before the video loads, and to anyone with reduced motion on."
    },
    { "type": "header", "content": "Buttons (optional — hidden when both are blank)" },
    { "type": "text", "id": "cta_label", "label": "Primary label" },
    { "type": "url", "id": "cta_url", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary label" },
    { "type": "url", "id": "cta2_url", "label": "Secondary link" },
    { "type": "text", "id": "scroll_cue", "label": "Scroll cue", "default": "Scroll" }
  ],
  "presets": [{ "name": "Hero — brand stripe" }]
}
{% endschema %}
