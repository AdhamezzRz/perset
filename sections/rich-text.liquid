{%- comment -%}
  RICH TEXT

  A centred block of copy with room around it. Used between heavier sections
  to let the page breathe: eyebrow, heading, a short paragraph, two buttons.

  Nothing here is hardcoded — the merchant owns every word.
{%- endcomment -%}

<section
  class="ps-rt{% if section.settings.wash_bg %} ps-wash-bg{% endif %}"
  {% if section.settings.pigment != 'none' %}data-ps-pigment="{{ section.settings.pigment }}"{% endif %}
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">

  <div class="ps-shell ps-shell--narrow ps-rt__inner" data-ps-stagger="110">

    {%- if section.settings.eyebrow != blank -%}
      <p class="ps-eyebrow ps-eyebrow--center" data-ps-reveal="fade">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="ps-rt__heading" data-ps-split="lines" data-ps-split-step="110">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="ps-prose ps-rt__body" data-ps-reveal="up">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
      <div class="ps-rt__actions" data-ps-reveal="up">
        {%- if section.settings.cta_label != blank -%}
          <a
            class="ps-btn{% if section.settings.cta_style == 'accent' %} ps-btn--accent{% endif %}"
            href="{{ section.settings.cta_url | default: '/collections/frontpage' }}"
            data-ps-magnetic="0.2">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="ps-link" href="{{ section.settings.cta2_url | default: routes.collections_url }}">
            {{ section.settings.cta2_label }}
            {% render 'icon', name: 'arrow-right', size: 15 %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_thread -%}
      <div class="ps-rt__thread" aria-hidden="true">
        {% render 'icon', name: 'thread', draw: true %}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .ps-rt { position: relative; }

  .ps-rt__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 1.8rem);
    text-align: center;
  }

  .ps-rt__heading {
    font-family: var(--ps-display);
    font-size: clamp(2rem, 5.4vw, 4.2rem);
    font-weight: 300;
    font-variation-settings: "SOFT" 42, "WONK" 1, "opsz" 144;
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 18ch;
  }

  .ps-rt__body {
    max-width: 54ch;
    margin-inline: auto;
    color: var(--ps-ink-soft);
    font-size: var(--ps-step-0);
    line-height: 1.68;
  }
  .ps-rt__body ul li { text-align: left; }

  .ps-rt__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2.2rem);
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }

  .ps-rt__thread { width: min(100%, 20rem); margin-top: 0.6rem; }

  @media (max-width: 640px) {
    .ps-rt__heading { max-width: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In the studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beautiful per piece, perfect per set" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Every set is twenty-four or sixteen pieces, packed together so a table of six or four is always ready to be laid.</p>"
    },
    {
      "type": "select",
      "id": "pigment",
      "label": "Pigment",
      "options": [
        { "value": "none", "label": "Linen (default)" },
        { "value": "wild", "label": "Stitches of the Wild" },
        { "value": "beads", "label": "A Tale in Beads" },
        { "value": "past", "label": "Pretty Past" }
      ],
      "default": "none"
    },
    { "type": "checkbox", "id": "wash_bg", "label": "Fill the section with the pigment wash", "default": false },
    { "type": "checkbox", "id": "show_thread", "label": "Show stitched rule", "default": true },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_label", "label": "Primary label", "default": "Shop the collections" },
    { "type": "url", "id": "cta_url", "label": "Primary link" },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Primary style",
      "options": [
        { "value": "ink", "label": "Ink" },
        { "value": "accent", "label": "Pigment" }
      ],
      "default": "ink"
    },
    { "type": "text", "id": "cta2_label", "label": "Secondary label" },
    { "type": "url", "id": "cta2_url", "label": "Secondary link" },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 220, "step": 4, "unit": "px", "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 220, "step": 4, "unit": "px", "default": 112
    }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
