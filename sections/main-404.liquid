{%- comment -%}
  404

  Not an error page so much as a wrong turn. Big display type, one line in the
  house voice, and the three collections laid out as a way back.
{%- endcomment -%}

<section
  class="ps-404"
  {% if section.settings.pigment != 'none' %}data-ps-pigment="{{ section.settings.pigment }}"{% endif %}
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">

  <span class="ps-404__wash" aria-hidden="true"></span>

  <div class="ps-shell ps-404__inner">

    <p class="ps-eyebrow" data-ps-reveal="fade">
      {{ section.settings.eyebrow | default: 'Four hundred and four' }}
    </p>

    <h1 class="ps-404__num" data-ps-split="chars" data-ps-split-step="70" aria-label="404">404</h1>

    <p class="ps-404__line" data-ps-reveal="up" style="--ps-delay:220ms">
      {{ section.settings.body | default: 'This page is not here. Nothing broke — the table was just set somewhere else.' }}
    </p>

    <div class="ps-404__thread" aria-hidden="true">
      {% render 'icon', name: 'thread', draw: true %}
    </div>

    {%- comment -%} The way back: the three collections, then the shop. {%- endcomment -%}
    <div class="ps-404__links" data-ps-stagger="90">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = collections[block.settings.collection]
          assign img = block.settings.image
          if img == blank and col.image != blank
            assign img = col.image
          endif
          if img == blank and col.products.first.featured_media != blank
            assign img = col.products.first.featured_media.preview_image
          endif
          assign title = block.settings.title | default: col.title
          assign url = col.url | default: block.settings.link | default: routes.collections_url
        -%}

        <a
          class="ps-404__card"
          href="{{ url }}"
          data-ps-pigment="{{ block.settings.pigment }}"
          data-ps-reveal="set"
          data-ps-cursor="{{ title | escape }}"
          {{ block.shopify_attributes }}>
          <span class="ps-404__plate ps-plate">
            {%- if img != blank -%}
              {{
                img
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  widths: '240,360,500,700',
                  sizes: '(max-width: 760px) 60vw, 22vw',
                  alt: title | escape
              }}
            {%- else -%}
              {{ 'collection-3' | placeholder_svg_tag: 'ps-404__ph' }}
            {%- endif -%}
          </span>
          <span class="ps-plate-shadow" aria-hidden="true"></span>
          <span class="ps-404__card-title">{{ title }}</span>
        </a>
      {%- endfor -%}
    </div>

    <div class="ps-404__actions" data-ps-reveal="fade">
      <a class="ps-btn" href="/collections/frontpage" data-ps-magnetic="0.2">
        {{ section.settings.cta_label | default: 'Everything we make' }}
        {% render 'icon', name: 'arrow-right', size: 15 %}
      </a>
      <a class="ps-link" href="{{ routes.search_url }}">
        {{ 'general.search.title' | t | default: 'Search' }}
      </a>
    </div>

  </div>
</section>

{% stylesheet %}
  .ps-404 {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
  }
  .ps-404__wash {
    position: absolute;
    inset: -30% -10%;
    z-index: -1;
    background:
      radial-gradient(44% 44% at 20% 12%, var(--ps-wash, var(--ps-linen-warm)), transparent 64%),
      radial-gradient(40% 40% at 82% 80%, var(--ps-wash, var(--ps-linen-warm)), transparent 62%);
    opacity: 0.85;
    filter: blur(20px);
  }

  .ps-404__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.4rem);
  }

  .ps-404__num {
    font-family: var(--ps-display);
    font-size: clamp(6rem, 26vw, 18rem);
    font-weight: 200;
    font-variation-settings: "SOFT" 60, "WONK" 1, "opsz" 144;
    line-height: 0.82;
    letter-spacing: -0.05em;
    margin: 0;
    color: var(--ps-ink);
  }

  .ps-404__line {
    font-family: var(--ps-display);
    font-size: var(--ps-step-2);
    font-style: italic;
    font-variation-settings: "SOFT" 50, "WONK" 1, "opsz" 144;
    line-height: 1.3;
    max-width: 28ch;
    color: var(--ps-ink-soft);
  }

  .ps-404__thread { width: min(100%, 18rem); margin-block: 0.4rem 1rem; }

  .ps-404__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
    width: min(100%, 60rem);
    margin-top: var(--ps-s-s);
  }

  .ps-404__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--ps-s-xs);
  }
  .ps-404__plate {
    width: 100%;
    box-shadow: 0 16px 44px rgba(120, 95, 60, 0.18);
    transition: transform var(--ps-t-slow) var(--ps-ease-set);
  }
  .ps-404__card:hover .ps-404__plate { transform: rotate(-7deg) scale(1.04); }
  .ps-404__ph { width: 100%; height: 100%; }
  .ps-404__card-title {
    font-family: var(--ps-display);
    font-size: var(--ps-step-0);
    line-height: 1.2;
    letter-spacing: 0.01em;
    transition: color var(--ps-t-fast) var(--ps-ease-swap);
  }
  .ps-404__card:hover .ps-404__card-title { color: var(--ps-accent); }

  .ps-404__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 3vw, 2.2rem);
    flex-wrap: wrap;
    margin-top: var(--ps-s-l);
  }

  @media (max-width: 640px) {
    .ps-404__links { grid-template-columns: 1fr; width: min(100%, 18rem); gap: var(--ps-s-l); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Four hundred and four" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Copy",
      "default": "This page is not here. Nothing broke — the table was just set somewhere else."
    },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Everything we make" },
    {
      "type": "select",
      "id": "pigment",
      "label": "Pigment",
      "options": [
        { "value": "none", "label": "Linen (default)" },
        { "value": "wild", "label": "Stitches of the Wild" },
        { "value": "beads", "label": "A Tale in Beads" },
        { "value": "past", "label": "Pretty Past" }
      ],
      "default": "wild"
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 300, "step": 4, "unit": "px", "default": 180
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 300, "step": 4, "unit": "px", "default": 140
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "url", "id": "link", "label": "Fallback link" },
        {
          "type": "select",
          "id": "pigment",
          "label": "Pigment",
          "options": [
            { "value": "wild", "label": "Stitches of the Wild" },
            { "value": "beads", "label": "A Tale in Beads" },
            { "value": "past", "label": "Pretty Past" }
          ],
          "default": "wild"
        }
      ]
    }
  ]
}
{% endschema %}
