{%- comment -%}
  Per Set icon set. Every glyph is drawn on a 24 box with a 1.4 stroke so it
  sits at the same optical weight as Jost at body size.

  Usage: {% render 'icon', name: 'cart', size: 20 %}
{%- endcomment -%}

{%- liquid
  assign s = size | default: 20
-%}

{%- case name -%}

  {%- when 'cart' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 7h16l-1.2 11.2a2 2 0 0 1-2 1.8H7.2a2 2 0 0 1-2-1.8Z"/>
      <path d="M8.75 7V5.6a3.25 3.25 0 0 1 6.5 0V7"/>
    </svg>

  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true" focusable="false">
      <circle cx="10.8" cy="10.8" r="6.3"/>
      <path d="m15.4 15.4 4.1 4.1"/>
    </svg>

  {%- when 'account' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="8.4" r="3.7"/>
      <path d="M4.9 19.6a7.4 7.4 0 0 1 14.2 0"/>
    </svg>

  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M4 8.5h16M4 15.5h11"/>
    </svg>

  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M6.4 6.4l11.2 11.2M17.6 6.4 6.4 17.6"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg class="ps-arrow" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4.5 12h15M13.5 6l6 6-6 6"/>
    </svg>

  {%- when 'arrow-left' -%}
    <svg class="ps-arrow" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M19.5 12h-15M10.5 6l-6 6 6 6"/>
    </svg>

  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M12 5.5v13M5.5 12h13"/>
    </svg>

  {%- when 'minus' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M5.5 12h13"/>
    </svg>

  {%- when 'chevron-down' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m6.5 9.5 5.5 5.5 5.5-5.5"/>
    </svg>

  {%- comment -%} A French knot: the mark that separates things across the site. {%- endcomment -%}
  {%- when 'knot' -%}
    <svg class="ps-knot" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" focusable="false">
      <path d="M12 3.5v17M4.4 7.8l15.2 8.4M19.6 7.8 4.4 16.2"/>
    </svg>

  {%- comment -%} The hand-drawn rule used in place of an <hr>. {%- endcomment -%}
  {%- when 'thread' -%}
    <svg class="ps-thread{% if draw %} ps-thread--draw{% endif %}" viewBox="0 0 1200 10" preserveAspectRatio="none" width="100%" height="10" aria-hidden="true" focusable="false">
      <path d="M0 5 C 100 1, 200 9, 300 5 S 500 1, 600 5 S 800 9, 900 5 S 1100 1, 1200 5"/>
    </svg>

  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M20 4C10 4 4 9.5 4 16a4 4 0 0 0 4 4c6.5 0 12-6 12-16Z"/>
      <path d="M4.5 19.5 14 10"/>
    </svg>

  {%- when 'brush' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M9.5 14.5 19 5a2.1 2.1 0 0 1 3 3l-9.5 9.5"/>
      <path d="M9.5 14.5c-2.2-.6-3.9.7-4.4 2.4-.3 1.1-.8 1.8-2.1 2.4 1.6 1.6 4.2 1.9 5.9.7 1.4-1 1.9-3 .6-5.5Z"/>
    </svg>

  {%- when 'box' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3.5 7.6 12 3.6l8.5 4v8.8L12 20.4l-8.5-4Z"/>
      <path d="M3.5 7.6 12 11.6l8.5-4M12 11.6v8.8"/>
    </svg>

  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false">
      <rect x="3.6" y="3.6" width="16.8" height="16.8" rx="5"/>
      <circle cx="12" cy="12" r="3.9"/>
      <circle cx="16.9" cy="7.1" r="1"/>
    </svg>

  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M14.2 3.5v10.9a3.6 3.6 0 1 1-3.6-3.6"/>
      <path d="M14.2 6.2a4.6 4.6 0 0 0 4.4 3.3"/>
    </svg>

  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M14.8 8.2h2.4M14.8 21V8.6a2.6 2.6 0 0 1 2.6-2.6h1M11 12.6h4.5"/>
    </svg>

  {%- when 'whatsapp' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3.8 20.2 5 16.5a8 8 0 1 1 3 2.9Z"/>
      <path d="M9.2 9.1c.6 2.6 2.4 4.4 5 5l1-1.4 1.7.8c-.3 1.2-1.5 1.8-2.8 1.5-3-.7-5.2-2.9-5.9-5.9-.3-1.3.3-2.5 1.5-2.8l.8 1.7Z"/>
    </svg>

{%- endcase -%}
