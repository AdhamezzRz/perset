{%- comment -%}
  Per Set product card.

  The plate sits inside a coloured wash, lifts and turns on hover, and a ring
  of stitching draws itself around it. A second image, when the product has
  one, cross-fades underneath.

  Accepts:
    product   {Object}  required
    pigment   {String}  wild | beads | past — tints the wash and the ring
    reveal    {String}  reveal mode, default "set"
    heading   {String}  h-level for the title, default "h3"
    show_type {Boolean} show product type under the title
{%- endcomment -%}

{%- liquid
  assign pig = pigment
  if pig == blank
    assign pig = product.metafields.perset.pigment.value
  endif
  if pig == blank
    for col in product.collections
      case col.handle
        when 'stitches-of-the-wild'
          assign pig = 'wild'
        when 'a-tale-in-beads'
          assign pig = 'beads'
        when 'pretty-past'
          assign pig = 'past'
      endcase
    endfor
  endif

  assign rev = reveal
  if rev == blank
    assign rev = settings.card_reveal | default: 'set'
  endif

  assign tag = heading | default: 'h3'

  assign second = nil
  if settings.card_show_second_image
    assign second = product.media[1]
  endif
-%}

<article
  class="ps-card"
  {% if pig != blank %}data-ps-pigment="{{ pig }}"{% endif %}
  data-ps-reveal="{{ rev }}">

  <div class="ps-card__frame" data-ps-cursor="View">
    {%- if product.available == false -%}
      <span class="ps-badge ps-badge--sold">{{ 'products.product.sold_out' | t | default: 'Sold out' }}</span>
    {%- elsif product.compare_at_price > product.price -%}
      <span class="ps-badge ps-badge--accent">{{ 'products.product.on_sale' | t | default: 'Sale' }}</span>
    {%- endif -%}

    <span class="ps-card__ring" aria-hidden="true"></span>

    <button
      class="ps-card__fav"
      type="button"
      data-ps-fav-toggle
      data-ps-fav-handle="{{ product.handle }}"
      data-ps-fav-label-off="{{ 'general.favorites.add' | t | default: 'Save to favourites' | escape }}"
      data-ps-fav-label-on="{{ 'general.favorites.remove' | t | default: 'Remove from favourites' | escape }}"
      data-ps-fav-added="{{ 'general.favorites.added' | t | default: 'Saved to your favourites.' | escape }}"
      data-ps-fav-removed="{{ 'general.favorites.removed' | t | default: 'Removed from your favourites.' | escape }}"
      aria-pressed="false"
      aria-label="{{ 'general.favorites.add' | t | default: 'Save to favourites' | escape }}">
      <span class="ps-card__fav-icon ps-card__fav-icon--off">{% render 'icon', name: 'heart', size: 16 %}</span>
      <span class="ps-card__fav-icon ps-card__fav-icon--on">{% render 'icon', name: 'heart-filled', size: 16 %}</span>
    </button>

    <div class="ps-card__media">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '300,420,600,900',
            sizes: '(max-width: 640px) 78vw, (max-width: 1024px) 40vw, 26vw',
            alt: product.featured_media.alt | default: product.title | escape
        }}
        {%- if second and second.media_type == 'image' -%}
          {{
            second
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '300,420,600,900',
              sizes: '(max-width: 640px) 78vw, (max-width: 1024px) 40vw, 26vw',
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'ps-placeholder' }}
      {%- endif -%}
    </div>
  </div>

  <div class="ps-card__body">
    <{{ tag }} class="ps-card__title">
      <a class="ps-card__link" href="{{ product.url }}">
        <span class="ps-sr">{{ product.title | escape }}</span>
      </a>
      <span aria-hidden="true">{{ product.title }}</span>
    </{{ tag }}>

    {%- liquid
      assign want_type = show_type
      if want_type == nil
        assign want_type = settings.card_show_type
      endif
    -%}
    {%- if want_type and product.type != blank -%}
      <p class="ps-card__meta">{{ product.type }}</p>
    {%- elsif product.metafields.perset.pieces.value != blank -%}
      <p class="ps-card__meta">{{ product.metafields.perset.pieces.value }}</p>
    {%- endif -%}

    {%- if settings.card_show_vendor and product.vendor != blank -%}
      <p class="ps-card__meta">{{ product.vendor }}</p>
    {%- endif -%}

    {%- liquid
      comment
        The card shows the price of the variant the product page opens on
        (the 24-piece set while it is in stock), so the two never disagree.
      endcomment
      assign card_variant = product.selected_or_first_available_variant | default: product.variants.first
    -%}
    <p class="ps-card__price">
      {%- if card_variant.compare_at_price > card_variant.price -%}
        <del>{{ card_variant.compare_at_price | money }}</del>
      {%- endif -%}
      {{ card_variant.price | money }}
    </p>
  </div>
</article>
